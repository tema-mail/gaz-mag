# gaz-mag.ru на сервере заказчика: nginx хоста → контейнеры на 127.0.0.1 (deploy/client/compose.override.yml).
# Ставит deploy/client/install.sh в /etc/nginx/sites-enabled/gaz-mag.ru, когда сертификат уже выпущен.
# Все переадресации – 301 (308 Яндекс не склеивает, см. историю Caddy 30.10).
server {
    listen 80;
    listen [::]:80;
    server_name gaz-mag.ru www.gaz-mag.ru;

    # certbot --webroot кладёт файлы в <webroot>/.well-known/acme-challenge/ – поэтому root, не alias
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://gaz-mag.ru$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.gaz-mag.ru;

    ssl_certificate /etc/letsencrypt/live/gaz-mag.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gaz-mag.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://gaz-mag.ru$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name gaz-mag.ru;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/gaz-mag.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gaz-mag.ru/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    # фото из админки – до 14 МБ (server/lead.mjs)
    client_max_body_size 16m;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;

    location /api/ {
        proxy_pass http://127.0.0.1:18090;
    }

    location / {
        proxy_pass http://127.0.0.1:18080;
    }
}
