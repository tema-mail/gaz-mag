---
// Блок «Контакты» перед подвалом – как на оригинале (адрес, телефон, мессенджеры) + карта.
import { SITE, SOCIALS } from '../lib/site';
import { Social } from '../islands/icons';
const map = 'https://yandex.ru/map-widget/v1/?text=' + encodeURIComponent('Болотное, улица Забабонова, 55А') + '&z=16';
---
<section class="section container" id="contacts">
  <div class="ct">
    <div class="ct__card soft-card">
      <h2 class="h2">Контакты</h2>
      <ul class="ct__list">
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>{SITE.address}</li>
        {SITE.phones.map((p) => (
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg><a href={p.href}>{p.text}</a></li>
        ))}
        <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      </ul>
      <div class="ct__soc">
        {SOCIALS.map((s) => <a class="icon-btn" href={s.href} target="_blank" rel="noopener nofollow" aria-label={s.label}><Social id={s.id} size={18} /></a>)}
      </div>
    </div>
    <div class="ct__map" data-map={map}>
      <div class="ct__stub">
        <p>Карту показывает Яндекс: он сохранит свои cookie и соберёт статистику. Показываем её только с вашего согласия.</p>
        <button type="button" class="btn btn--navy btn--sm" data-map-allow>Показать карту</button>
        <a href={'https://yandex.ru/maps/?text=' + encodeURIComponent('Болотное, улица Забабонова, 55А')} target="_blank" rel="noopener">Открыть на Яндекс Картах</a>
      </div>
    </div>
  </div>
</section>
<style>
  .ct { display: grid; grid-template-columns: minmax(0, 480px) 1fr; gap: 20px; }
  .ct__card { padding: 40px 32px; display: grid; gap: 20px; align-content: start; }
  .ct__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; font-size: 15px; }
  .ct__list li { display: flex; gap: 12px; align-items: flex-start; }
  .ct__list svg { flex: none; margin-top: 4px; color: var(--navy); }
  .ct__list a:hover { text-decoration: underline; }
  .ct__soc { display: flex; gap: 8px; }
  .ct__map { position: relative; width: 100%; height: 100%; min-height: 340px; border-radius: var(--radius-xl); background: var(--soft); overflow: hidden; display: grid; place-items: center; }
  .ct__map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .ct__stub { display: grid; gap: 12px; justify-items: center; max-width: 380px; padding: 24px; text-align: center; font-size: 14px; }
  .ct__stub a { color: var(--navy); text-decoration: underline; font-size: 13px; }
  @media (max-width: 1023px) { .ct { grid-template-columns: 1fr; } .ct__card { padding: 28px 20px; } .ct__map { min-height: 280px; } }
</style>
<script>
  import { CONSENT_EVENT, readConsent, saveConsent } from '../lib/consent';
  // Карта грузится только при согласии на сервисы Яндекса; «Показать карту» – это и есть согласие.
  const box = document.querySelector<HTMLElement>('[data-map]');
  const load = () => {
    if (!box || box.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = box.dataset.map!; f.title = 'Магазин на карте: Болотное, ул. Забабонова, 55А'; f.loading = 'lazy';
    box.querySelector('.ct__stub')?.setAttribute('hidden', '');
    box.append(f);
  };
  const unload = () => { box?.querySelector('iframe')?.remove(); box?.querySelector('.ct__stub')?.removeAttribute('hidden'); };
  if (readConsent()?.yandex) load();
  window.addEventListener(CONSENT_EVENT, (e) => ((e as CustomEvent).detail.yandex ? load() : unload()));
  box?.querySelector('[data-map-allow]')?.addEventListener('click', () => saveConsent(true));
</script>
