---
// Закрытый раздел кабинета – общий для всех ЛК (владелец 17.10.2026: «базово во все ЛК ставь; пока я не скажу,
// что собираем, на странице – замочек и „раздел закрыт“»). За замком – размытый каркас раздела без цифр, данных нет
// и не грузятся. Перенесён с ALEX KROWN (src/v1/admin/Locked.astro), образец – TEYES Sibir; стили – здесь же.
interface Props { title: string; about: string; items: string[]; lead?: string }
const { title, about, items, lead = 'Это расширенная аналитика. Доступ – только клиентам на постоянном SEO-обслуживании.' } = Astro.props;
---
<section class="locked" aria-labelledby="locked-h">
  <div class="locked__ghost" aria-hidden="true">
    <div class="locked__kpis">{[1, 2, 3, 4, 5].map(() => <div><i></i><b></b></div>)}</div>
    <div class="locked__rows">{Array.from({ length: 9 }, (_, n) => <div><i style={`width:${38 + ((n * 17) % 40)}%`}></i><b></b><b></b><b></b></div>)}</div>
  </div>
  <div class="locked__card">
    <svg class="locked__icon" width="56" height="56" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4.5" y="10.5" width="15" height="10" rx="2.5"></rect>
      <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path>
      <circle cx="12" cy="15.2" r="1.3"></circle><path d="M12 16.5v1.6"></path>
    </svg>
    <h1 id="locked-h">{title}: раздел закрыт</h1>
    <p class="locked__lead">{lead}</p>
    <p class="locked__about">{about}</p>
    <ul>{items.map((i) => <li>{i}</li>)}</ul>
  </div>
</section>

<style>
.locked{position:relative;min-height:560px;border-radius:12px;overflow:hidden;background:#fff;border:1px solid #e2e5e3}
.locked__ghost{position:absolute;inset:0;padding:22px;display:grid;gap:18px;align-content:start;filter:blur(5px);opacity:.55;pointer-events:none}
.locked__kpis{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.locked__kpis div{height:74px;border-radius:10px;background:#f1f3f2;display:grid;gap:8px;padding:12px;align-content:start}
.locked__kpis i,.locked__rows i{display:block;height:10px;border-radius:5px;background:#d9dedc;width:60%}
.locked__kpis b{display:block;height:20px;border-radius:6px;background:#c9cfcc;width:45%}
.locked__rows{display:grid;gap:10px}
.locked__rows div{display:grid;grid-template-columns:minmax(0,1fr) 70px 70px 70px;gap:14px;align-items:center;height:34px;border-bottom:1px solid #eef0ef}
.locked__rows b{display:block;height:12px;border-radius:5px;background:#e3e7e5}
.locked__card{position:relative;max-width:560px;margin:70px auto;background:#fff;border:1px solid #e2e5e3;border-radius:16px;padding:30px 28px;box-shadow:0 20px 60px rgba(28,32,31,.12);text-align:center}
.locked__icon{color:#1c201f;margin:0 auto 12px;display:block}
.locked__card h1{margin:0 0 8px;font-size:22px;font-weight:600}
.locked__lead{margin:0 0 16px;font-size:15px;color:#1e1e1e}
.locked__about{margin:0 0 6px;font-size:13px;color:#77817e;text-align:left}
.locked__card ul{margin:0;padding-left:18px;text-align:left;font-size:13px;line-height:1.55;color:#55605d}
@media(max-width:700px){.locked__kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.locked__card{margin:40px 14px;padding:24px 18px}.locked{min-height:620px}}
</style>
