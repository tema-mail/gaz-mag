---
import { SITE, SOCIALS, NAV } from '../lib/site';
import { u } from '../lib/url';
import { img } from '../lib/img';
import { Social } from '../islands/icons';
import HeaderActions from '../islands/HeaderActions';
import MobileMenu from '../islands/MobileMenu';
const LOGO = 'https://static.tildacdn.com/tild6433-3131-4230-a438-613664356533/_1-2.png';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
const active = (href: string, children?: { href: string }[]) =>
  href === path || (children || []).some((c) => c.href === path) || (href !== '/' && path.startsWith(href + '/'));
---
<header class="hdr">
  <div class="container hdr__top">
    <a class="hdr__logo" href={u('/')} aria-label="Магазин газового оборудования – на главную">
      <img src={img(LOGO, 800)} alt="" width="44" height="44" />
      <span>Магазин газового<br class="hdr__br" /> оборудования</span>
    </a>
    <div class="hdr__right">
      <div class="hdr__socials">
        {SOCIALS.map((s) => (
          <a class="icon-btn" href={s.href} target="_blank" rel="noopener nofollow" aria-label={s.label}><Social id={s.id} size={16} /></a>
        ))}
      </div>
      {SITE.phones.map((p) => <a class="hdr__phone" href={p.href}>{p.text}</a>)}
      <HeaderActions client:idle variant="desktop" />
    </div>
    <div class="hdr__mobile">
      <HeaderActions client:idle variant="mobile" />
      <MobileMenu client:idle />
    </div>
  </div>
  <div class="container">
    <nav class="hdr__nav" aria-label="Основное меню">
      {NAV.map((n) => (
        <div class:list={['hdr__item', { 'has-sub': n.children }]}>
          <a href={u(n.href)} class:list={['hdr__link', { 'is-active': active(n.href, n.children) }]} aria-haspopup={n.children ? 'true' : undefined}>
            {n.label}{n.children && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>}
          </a>
          {n.children && (
            <div class="hdr__sub">
              {n.children.map((c) => <a href={u(c.href)} class:list={{ 'is-active': c.href === path }}>{c.label}</a>)}
            </div>
          )}
        </div>
      ))}
    </nav>
  </div>
</header>

<style>
  .hdr { position: relative; z-index: 40; background: var(--bg); }
  .hdr__top { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 80px; }
  .hdr__logo { display: flex; align-items: center; gap: 14px; font: 700 13px/1.35 var(--body-font); text-transform: uppercase; color: var(--ink); }
  .hdr__logo img { width: 44px; height: 44px; border-radius: 50%; }
  .hdr__br { display: none; }
  .hdr__right { display: flex; align-items: center; gap: 8px; }
  .hdr__socials { display: flex; gap: 8px; margin-right: 4px; }
  .hdr__socials .icon-btn { width: 40px; height: 40px; }
  .hdr__phone {
    display: inline-flex; align-items: center; height: 40px; padding: 0 20px; border-radius: 999px;
    background: var(--navy); color: var(--white); font: 700 11px/1 var(--body-font); letter-spacing: .1em; white-space: nowrap;
    transition: background-color .2s;
  }
  .hdr__phone:hover { background: var(--navy-dark); }
  .hdr__nav {
    display: flex; justify-content: space-around; align-items: center; height: 50px;
    background: var(--white); border-radius: 999px; box-shadow: 0 2px 14px rgba(30, 41, 78, .05);
  }
  .hdr__item { position: relative; height: 100%; display: flex; align-items: center; }
  .hdr__link {
    display: inline-flex; align-items: center; gap: 6px; padding: 0 12px; height: 100%;
    font: 700 13px/1 var(--body-font); text-transform: uppercase; color: var(--ink); letter-spacing: .02em; transition: color .2s;
  }
  .hdr__link:hover, .hdr__link.is-active { color: var(--navy-2); }
  .hdr__link.is-active { text-decoration: underline; text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .hdr__sub {
    position: absolute; top: 100%; left: 50%; min-width: 300px; padding: 10px; display: grid; gap: 2px;
    background: var(--white); border-radius: var(--radius-m); box-shadow: var(--shadow);
    opacity: 0; visibility: hidden; transform: translate(-50%, 8px); transition: opacity .2s, transform .2s var(--ease), visibility .2s;
  }
  .hdr__item:hover .hdr__sub, .hdr__item:focus-within .hdr__sub { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .hdr__sub a { padding: 10px 14px; border-radius: 10px; font-size: 14px; color: var(--ink); }
  .hdr__sub a:hover, .hdr__sub a.is-active { background: var(--soft); color: var(--navy); }
  .hdr__mobile { display: none; }

  @media (max-width: 1199px) { .hdr__socials { display: none; } }

  /* Телефон и планшет: липкая шапка – логотип, корзина, меню */
  @media (max-width: 1023px) {
    .hdr { position: sticky; top: 0; box-shadow: 0 1px 0 rgba(0, 0, 0, .06); }
    .hdr__top { height: var(--header-h); }
    .hdr__logo { font-size: 11px; gap: 10px; }
    .hdr__logo img { width: 40px; height: 40px; }
    .hdr__br { display: inline; }
    .hdr__right, .hdr__nav { display: none; }
    .hdr__mobile { display: flex; align-items: center; gap: 8px; }
  }
</style>
