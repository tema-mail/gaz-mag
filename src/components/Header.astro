---
import { SITE, SOCIALS, NAV } from '../lib/site';
import { u } from '../lib/url';
import { Social } from '../islands/icons';
import HeaderActions from '../islands/HeaderActions';
import MobileMenu from '../islands/MobileMenu';
import { menuTiles } from '../lib/menu';
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
---
<header class="hdr">
  <div class="container hdr__top">
    <a class="hdr__addr" href={u('/contact')}>
      <span class="hdr__pin" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
      </span>
      <span>г. {SITE.city}.<br />{SITE.address}</span>
    </a>
    <a class="hdr__logo" href={u('/')} aria-label="Milovini Flowers – на главную">
      <img src={u('/img/logo.svg')} alt="Milovini Flowers" width="291" height="21" />
    </a>
    <div class="hdr__right">
      <div class="hdr__socials">
        {SOCIALS.map((s) => (
          <a class="hdr__soc" href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Social id={s.id} size={15} /></a>
        ))}
      </div>
      <div class="hdr__phone">
        <a href={SITE.phoneHref}>{SITE.phone.replace(/-/g, ' ')}</a>
        <a class="hdr__call" href={SITE.phoneHref}>Связаться с нами</a>
      </div>
    </div>
    <div class="hdr__mobile-actions">
      <HeaderActions client:idle variant="mobile" />
      <MobileMenu client:idle tiles={menuTiles} />
    </div>
  </div>
  <div class="container hdr__bottom">
    <nav class="hdr__nav" aria-label="Основное меню">
      {NAV.map((n) => (
        <a href={u(n.href)} class:list={['hdr__link', { 'is-active': n.href === path }]}>{n.label}</a>
      ))}
    </nav>
    <HeaderActions client:idle variant="desktop" />
  </div>
</header>

<style>
  .hdr { position: relative; z-index: 40; background: var(--white); }
  .hdr__top {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px;
    height: 64px; border-bottom: 1px solid #d9d4d6;
  }
  .hdr__addr { display: flex; align-items: center; gap: 12px; font-size: 12px; line-height: 1.3; color: var(--ink); }
  .hdr__pin { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--pink); color: var(--mauve); flex: none; }
  .hdr__logo img { height: 28px; width: auto; }
  .hdr__right { display: flex; justify-content: flex-end; align-items: center; gap: 28px; }
  .hdr__socials { display: flex; gap: 8px; }
  .hdr__soc { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--pink); color: var(--mauve); transition: background-color .2s, color .2s; }
  .hdr__soc:hover { background: var(--mauve); color: var(--white); }
  .hdr__phone { display: grid; justify-items: end; gap: 2px; }
  .hdr__phone a:first-child { font: 700 14px/1.2 var(--body-font); color: var(--ink); white-space: nowrap; }
  .hdr__call { font-size: 12px; color: var(--ink); text-decoration: underline; text-underline-offset: 2px; }
  .hdr__bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
  .hdr__nav { display: flex; flex-wrap: wrap; gap: 4px 18px; }
  .hdr__link { font-size: 12px; color: var(--ink); position: relative; padding: 4px 0; white-space: nowrap; }
  .hdr__link::after { content: ''; position: absolute; left: 0; right: 100%; bottom: 0; height: 1px; background: var(--mauve); transition: right .25s var(--ease); }
  .hdr__link:hover::after, .hdr__link.is-active::after { right: 0; }
  .hdr__link.is-active { color: var(--mauve); }
  .hdr__mobile-actions { display: none; }

  @media (max-width: 1365px) { .hdr__nav { gap: 4px 12px; } .hdr__link { font-size: 11.5px; } }

  /* Телефон и планшет: компактная липкая шапка – логотип, избранное, корзина, меню */
  @media (max-width: 1023px) {
    .hdr { position: sticky; top: 0; box-shadow: 0 1px 0 rgba(0,0,0,.06); }
    .hdr__top { grid-template-columns: 1fr auto; height: var(--header-h); border-bottom: 0; }
    .hdr__addr, .hdr__right, .hdr__bottom { display: none; }
    .hdr__logo img { height: 17px; }
    .hdr__mobile-actions { display: flex; align-items: center; gap: 8px; }
  }
</style>
