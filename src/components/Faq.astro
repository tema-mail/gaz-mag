---
// Частые вопросы: раскрываются по клику, разметка FAQPage для поиска.
import SectionHead from './SectionHead.astro';
const { items, title = 'Часто задаваемые вопросы' } = Astro.props as { items: { q: string; a: string }[]; title?: string };
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---
<section class="section container">
  <SectionHead title={title} />
  <div class="faq">
    {items.map((i, n) => (
      <details class="faq__item">
        <summary><span class="faq__n">{String(n + 1).padStart(2, '0')}/</span><span class="faq__q">{i.q}</span><span class="faq__plus" aria-hidden="true" /></summary>
        <p class="faq__a" set:html={i.a.replace(/\n/g, '<br />')} />
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
<style>
  .faq { border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .faq__item + .faq__item { border-top: 1px solid var(--ink); }
  summary { display: flex; align-items: center; gap: 6px; padding: 30px 0; cursor: pointer; list-style: none; font: 400 19px/1.3 var(--body-font); color: var(--mauve); }
  summary::-webkit-details-marker { display: none; }
  .faq__q { flex: 1; }
  .faq__plus { position: relative; width: 28px; height: 28px; flex: none; }
  .faq__plus::before, .faq__plus::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--mauve); transition: transform .3s var(--ease); }
  .faq__plus::after { transform: rotate(90deg); }
  details[open] .faq__plus::after { transform: rotate(0); }
  .faq__a { padding: 0 60px 28px 0; font-size: 15px; line-height: 1.6; max-width: 900px; }
  @media (max-width: 1023px) {
    summary { padding: 20px 0; font-size: 15.5px; align-items: flex-start; }
    .faq__plus { width: 20px; height: 20px; margin-top: 2px; }
    .faq__a { padding: 0 0 20px; font-size: 14px; }
  }
</style>
