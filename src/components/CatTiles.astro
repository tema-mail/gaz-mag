---
// Плитки каталогов – как на главной и в /catalogcentr оригинала: сиреневая плашка, название, фото товара.
import { CATALOGS } from '../lib/site';
import { u } from '../lib/url';
import { img } from '../lib/img';
---
<div class="tiles">
  {CATALOGS.map((c) => (
    <a class="tile soft-card reveal" href={u(c.href)}>
      <span class="tile__t">{c.title}</span>
      <img src={img(c.image, 800)} alt="" loading="lazy" />
    </a>
  ))}
</div>
<style>
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .tile { position: relative; display: flex; align-items: center; min-height: 210px; padding: 24px; border-radius: var(--radius-l); transition: box-shadow .25s, transform .25s var(--ease); }
  .tile:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .tile__t { position: relative; z-index: 1; max-width: 62%; font: 500 clamp(20px, 2vw, 28px)/1.1 var(--head-font); text-transform: uppercase; color: var(--ink); }
  .tile img { position: absolute; right: 12px; bottom: 0; height: 92%; width: 42%; object-fit: contain; object-position: bottom right; }
  @media (max-width: 1023px) {
    .tiles { grid-template-columns: 1fr; gap: 10px; }
    .tile { min-height: 150px; padding: 18px; }
    .tile__t { font-size: 22px; max-width: 60%; }
  }
</style>
