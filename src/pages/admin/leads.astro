  { id: 'GM-261017-1540', createdAt: at(17, 8), name: 'Пример: Наталья', phone: '+7 900 000-00-32', form: 'Заказ в один клик: Котел газовый настенный двухконтурный NAVIEN DELUXE EXPERT 13-24кв (Мощность: 16 кВт)', page: '/catalog_boilers/tproduct/…', stage: 'в работе', source: 'Поиск Google', items: [{ uid: '765965851042', title: 'Котел газовый настенный двухконтурный NAVIEN DELUXE EXPERT 13-24кв', variant: 'Мощность: 16 кВт', category: 'catalog_boilers', qty: 1, price: 42000 }], category: 'catalog_boilers' },
  { id: 'GM-261017-1105', createdAt: at(17, 4), name: 'Пример: Андрей', phone: '+7 900 000-00-33', form: 'Квиз: подбор котла HUBERT', page: '/hubert', stage: 'новая', source: 'Прямые заходы', items: [], category: 'hubert', extra: [['Какова общая отапливаемая площадь помещения?', 'От 120 до 180 м²'], ['Какой бюджет на котёл с обвязкой?', 'Стандарт (50–70 тыс.)']] },
  { id: 'GM-261016-0930', createdAt: at(16, 2), name: 'Пример: Ольга', phone: '+7 900 000-00-34', form: 'Заявка на подключение газа и монтаж отопления', page: '/montag', stage: 'выполнена', source: 'Поиск Яндекса', items: [], category: 'montag' },
  { id: 'GM-261015-1720', createdAt: at(15, 10), name: 'Пример: ООО «Тепломонтаж»', phone: '+7 900 000-00-35', form: 'Акция: Для юридических лиц и монтажников скидка 7%', page: '/akcii/yur-licam-i-montazhnikam', stage: 'отказ', source: 'Соцсети и мессенджеры', items: [], category: 'akcii' },
];
const catsAll = { ...cats, hubert: 'Котлы HUBERT', montag: 'Подключение газа и монтаж', 'ustanovka-kotla': 'Установка котлов', akcii: 'Акции' };
---
<Admin title="Заявки" active="leads">
