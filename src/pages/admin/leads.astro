---
/** Админка → Заявки (перенос кабинета-стандарта Milovini; доска – эталон ALEX KROWN / EV). Заявки живые – с приёмника
    gaz-mag на Beget (server/lead.mjs, GET /api/leads по паролю кабинета). Пока заявок нет – пример с меткой «Пример:»
    на настоящих формах сайта: «Заказ из корзины», «Заказ в один клик», «Квиз: подбор котла HUBERT»,
    «Заявка на подключение газа и монтаж отопления», «Акция: …». Товары – реальные позиции каталога. */
import Admin from '../../layouts/Admin.astro';
import Leads, { type Lead } from '../../islands/admin/Leads';
import { CATALOGS } from '../../lib/site';
const at = (d: number, h: number) => new Date(Date.UTC(2026, 9, d, h)).toISOString();
const cats: Record<string, string> = Object.fromEntries(CATALOGS.map((c) => [c.slug, c.title]));
const sample: Lead[] = [
