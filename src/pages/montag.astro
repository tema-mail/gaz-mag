---
// /montag – «Подключение к газовым сетям и монтаж отопления». Адрес оригинала сохранён, тексты и вопросы –
// с оригинала, разложены в понятную структуру. Вопросы про сам котёл – на /ustanovka-kotla (без повторов).
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Steps from '../components/Steps.astro';
import LeadSection from '../components/LeadSection.astro';
import Faq from '../components/Faq.astro';
import { img } from '../lib/img';
import { u } from '../lib/url';
const T = 'https://static.tildacdn.com/';
const PHOTO = T + 'tild3938-6663-4939-b731-393463353432/gas-boiler.jpg';
const FORM_IMG = T + 'tild3431-6430-4533-b432-393136316435/Group_388.png';
const faq = [
  { q: 'Какие документы нужны для подключения газа в доме?', a: 'Для подключения газа необходимо предоставить проект газификации, технические условия от газоснабжающей организации, а также документы, подтверждающие право собственности на дом.' },
  { q: 'Сколько времени занимает процесс подведения газа в дом?', a: 'Срок подведения газа зависит от многих факторов, включая удалённость от газораспределительной станции и наличие необходимой инфраструктуры. В среднем процесс может занять от нескольких недель до нескольких месяцев.' },
  { q: 'Нужно ли получать разрешения для установки газового оборудования?', a: 'Да, для установки газового оборудования необходимо получить соответствующие разрешения и согласования в местных органах власти и газоснабжающих организациях.' },
  { q: 'Можно ли выполнить работы по подведению газа в зимний период?', a: 'Да, мы выполняем работы по подведению газа в любое время года.' },
  { q: 'Какие системы отопления вы устанавливаете?', a: 'Мы устанавливаем различные системы отопления, включая газовые котлы, системы водяного отопления и другие виды отопительных систем.' },
  { q: 'Какие гарантии предоставляются на выполненные работы по монтажу отопления?', a: 'Мы предоставляем гарантию на все выполненные работы.' },
];
---
<Base title="Подключение к газовым сетям и монтаж отопления в Болотном" description="Комплексное газооснащение дома: проект газоснабжения, подключение к газовой сети и ввод трубы в дом, установка котла, проверка вентиляции, монтаж системы отопления. Без очереди, гарантия на работы.">
  <PageHead crumbs={[{ label: 'Главная', href: '/' }, { label: 'Подключение к газовым сетям и монтаж отопления' }]} title="Подключение к газовым сетям и монтаж отопления" lead="Полное газооснащение вашего дома включает в себя все необходимые этапы, от проектирования системы до монтажа отопительного оборудования.">
    <div class="mg-cta">
      <button type="button" class="btn btn--navy" data-lead="Заявка на подключение газа и монтаж отопления">Оставить заявку</button>
      <a class="btn btn--outline" href={u('/akcii/montazh-ot-8000')}>Монтаж от 8 тыс. – акция</a>
    </div>
  </PageHead>

  <section class="section container">
    <Steps title="Мы выполняем" items={[
      { t: 'Разработку индивидуального проекта газоснабжения' },
      { t: 'Подключение к газовой сети и заведение газовой трубы в дом' },
      { t: 'Установку современного газового котла', d: 'Подробнее – на странице «Установка газовых котлов».' },
      { t: 'Проверку вентиляции на соответствие требованиям пожарной безопасности' },
      { t: 'Монтаж системы отопления' },
    ]} />
    <p class="mg-link"><a href={u('/ustanovka-kotla')}>Установка газовых котлов: что входит и какие котлы ставим →</a></p>
  </section>

  <section class="section container">
    <div class="mg-why">
      <img src={img(PHOTO)} alt="Монтаж газового котла" loading="lazy" />
      <div class="mg-why__cols">
        <div>
          <h2 class="h3">Мы гарантируем</h2>
          <ul>
            <li>Быструю установку оборудования сертифицированными специалистами</li>
            <li>Профессиональный монтаж</li>
            <li>Соответствие всем техническим нормам и стандартам</li>
          </ul>
        </div>
        <div>
          <h2 class="h3">Мы предлагаем</h2>
          <ul>
            <li>Стоимость услуг ниже, чем у государственных компаний</li>
            <li>Отсутствие ожидания очереди на монтаж</li>
            <li>Большой выбор газовых котлов и материалов – <a href={u('/catalogcentr')}>каталог</a></li>
          </ul>
        </div>
        <div>
          <h2 class="h3">Наши специалисты</h2>
          <ul>
            <li>Проконсультируют по всем вопросам газоснабжения</li>
            <li>Помогут подобрать оптимальное оборудование</li>
            <li>Предложат индивидуальное решение для вашего дома</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <LeadSection form="Заявка на подключение газа и монтаж отопления" text="Мы выполним полный спектр услуг и предоставим лучшее оборудование на рынке для вашего дома. Оставьте заявку и наши специалисты свяжутся с Вами в ближайшее время." image={FORM_IMG} />

  <section class="section container">
    <div class="prose">
      <h2 class="h2">Но это ещё не всё!</h2>
      <p>В нашем магазине вы найдёте всё для отопления и газоснабжения, также мы принимаем индивидуальные заявки на обслуживание и ремонт газовых котлов и водонагревателей.</p>
      <p>Особое внимание мы уделяем сотрудничеству с юридическими лицами и монтажными организациями. Мы предлагаем выгодные условия, индивидуальный подход и оперативную доставку – <a href={u('/akcii/yur-licam-i-montazhnikam')}>скидка 7% для юрлиц и монтажников</a>. Наша команда готова стать вашим надёжным партнёром в реализации любых проектов, связанных с газовым оборудованием.</p>
    </div>
  </section>

  <Faq items={faq} title="Вопросы о подключении газа и монтаже отопления" />
</Base>
<style>
  .mg-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .mg-link { margin-top: 18px; font-weight: 600; }
  .mg-link a { color: var(--navy); text-decoration: underline; text-underline-offset: 3px; }
  .mg-why { display: grid; grid-template-columns: .8fr 1.2fr; gap: 32px; align-items: start; }
  .mg-why img { width: 100%; border-radius: var(--radius-xl); aspect-ratio: 4 / 5; object-fit: cover; }
  .mg-why__cols { display: grid; gap: 28px; }
  .mg-why__cols ul { margin: 12px 0 0; padding-left: 20px; display: grid; gap: 6px; }
  .mg-why__cols a, .prose a { color: var(--navy); text-decoration: underline; }
  @media (max-width: 1023px) { .mg-why { grid-template-columns: 1fr; } .mg-why img { aspect-ratio: 16 / 10; } }
</style>
