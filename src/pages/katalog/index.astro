---
// /catalogcentr – общий каталог, как на оригинале: плитки 6 каталогов. Ниже – «Специальные предложения».
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import CatTiles from '../../components/CatTiles.astro';
import ProductRow from '../../components/ProductRow.astro';
import { listCards } from '../../lib/catalog';
const specials = listCards('specials');
---
<Base title="Каталог газового оборудования – Новосибирск и Болотное | Магазин газового оборудования" description="Каталог магазина газового оборудования (Болотное, работаем по Новосибирску): газовые котлы, газовые и электрические водонагреватели, бойлеры косвенного нагрева, радиаторы, датчики загазованности и модули управления.">
  <PageHead crumbs={[{ label: 'Главная', href: '/' }, { label: 'Каталог' }]} title="Каталог" />
  <section class="section--tight container"><CatTiles /></section>
  {specials.length > 0 && (
    <section class="section container">
      <h2 class="h2" style="margin-bottom:28px">Специальные предложения</h2>
      <ProductRow cards={specials} />
    </section>
  )}
</Base>
