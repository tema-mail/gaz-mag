---
// 6 каталогов по адресам оригинала: /catalog_boilers, /catalog_gaz_waterheaters, … /gas.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Catalog from '../islands/Catalog';
import { CATALOGS, SITE } from '../lib/site';
import { filterDefs, listCards } from '../lib/catalog';

export function getStaticPaths() {
  return CATALOGS.map((c) => ({ params: { catalog: c.slug }, props: { c } }));
}
const { c } = Astro.props;
const cards = listCards(c.slug);
---
<Base title={c.seoTitle} description={c.seoDescr}>
  <PageHead crumbs={[{ label: 'Главная', href: '/' }, { label: 'Каталог', href: '/catalogcentr' }, { label: c.title }]} title={c.h1} lead={`${cards.length} ${cards.length % 10 === 1 && cards.length % 100 !== 11 ? 'товар' : cards.length % 10 >= 2 && cards.length % 10 <= 4 && (cards.length % 100 < 10 || cards.length % 100 >= 20) ? 'товара' : 'товаров'} в каталоге. Магазин в Болотном, ${SITE.addressShort.replace('г. Болотное, ', '')}; работаем по Новосибирску и Болотному.`} />
  <section class="section--tight container">
    <Catalog client:load cards={cards} filters={filterDefs(c.slug)} />
  </section>
</Base>
