---
import { R } from '../lib/routes';
// Главная – как на оригинале: первый экран, плитки каталогов, «Специальные предложения»,
// слайдер акций, «Подключение к газовым сетям и монтаж отопления», контакты (в Base).
import Base from '../layouts/Base.astro';
import CatTiles from '../components/CatTiles.astro';
import PromoSlider from '../components/PromoSlider.astro';
import ProductRow from '../components/ProductRow.astro';
import { img } from '../lib/img';
import { u } from '../lib/url';
import { listCards } from '../lib/catalog';
import { NSK_POINT, SITE } from '../lib/site';
const T = 'https://static.tildacdn.com/';
const HERO_BG = T + 'tild6337-3361-4932-a238-636534396537/Mask_group.png';
const HERO = T + 'tild3032-6337-4166-b464-643130313366/Group_554.png';
const MONTAG = T + 'tild3530-3633-4538-b536-643063636434/Rectangle_401_1.png';
const specials = listCards('specials');
// Разметка организации: магазин в Болотном, работаем по Новосибирску и Болотному, пункт выдачи HUBERT в Новосибирске.
// Часы работы не указаны – их нет на оригинале (ТЕХДОЛГ).
const org = {
  '@context': 'https://schema.org', '@type': 'Store', name: SITE.name, url: Astro.site?.href,
  telephone: SITE.phones.map((p) => p.href.replace('tel:', '')), email: SITE.email,
  address: { '@type': 'PostalAddress', streetAddress: 'ул. Забабонова, 55А', addressLocality: 'Болотное', addressRegion: 'Новосибирская область', addressCountry: 'RU' },
  areaServed: [{ '@type': 'City', name: 'Новосибирск' }, { '@type': 'City', name: 'Болотное' }],
  department: [{ '@type': 'Store', name: `${SITE.name} – пункт выдачи в Новосибирске`, telephone: NSK_POINT.phone.href.replace('tel:', ''),
    address: { '@type': 'PostalAddress', streetAddress: NSK_POINT.address, addressLocality: 'Новосибирск', addressRegion: 'Новосибирская область', addressCountry: 'RU' } }],
};
---
<Base title="Газовое оборудование в Новосибирске и Болотном – газовые котлы, колонки, бойлеры | Магазин газового оборудования" description="Магазин газового оборудования в Болотном, работаем по Новосибирску: газовые котлы HUBERT, Navien, Haier, Очаг, газовые колонки, водонагреватели, бойлеры косвенного нагрева. Подключение газа, монтаж отопления, установка котла от 8 тыс. ₽.">
  <section class="container hero-wrap">
    <div class="hero navy-card" style={`background-image:url(${img(HERO_BG)})`}>
      <div class="hero__text">
        <h1 class="h1">Продажа газового оборудования и других отопительных приборов</h1>
        <button type="button" class="btn btn--white" data-lead="Заказать с главной">Заказать</button>
      </div>
      <img class="hero__img" src={img(HERO)} alt="Газовые котлы в магазине" width="800" height="500" />
    </div>
  </section>

  <section class="section container">
    <CatTiles />
  </section>

  {specials.length > 0 && (
    <section class="section container" id="specials">
      <h2 class="h2">Специальные предложения</h2>
      <ProductRow cards={specials} />
    </section>
  )}

  <section class="section container" id="sales">
    <div class="sales-head">
      <h2 class="h2">Акции</h2>
      <a class="btn btn--outline btn--sm" href={u(R.promos)}>Все акции</a>
    </div>
    <PromoSlider />
  </section>

  <section class="section container" id="delivery">
    <div class="mt soft-card">
      <div class="mt__text">
        <h2 class="h2">Подключение к газовым сетям и монтаж отопления</h2>
        <p class="lead">Выполним полное газооснащение Вашего дома, от проектирования системы газоснабжения до монтажа отопительного оборудования и сервисного обслуживания.</p>
        <div class="mt__btns">
          <a class="btn btn--navy" href={u(R.montag)}>Подробнее</a>
          <a class="btn btn--outline" href={u(R.install)}>Установка котлов</a>
        </div>
      </div>
      <img class="mt__img" src={img(MONTAG)} alt="Мастер подключает газовый котёл" loading="lazy" />
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
</Base>
<style>
  .hero-wrap { padding-top: 20px; }
  .hero { position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: center; min-height: 460px; padding: 56px 0 0 36px; background-size: cover; background-position: center; }
  .hero__text { display: grid; gap: 28px; justify-items: start; padding-bottom: 56px; }
  .hero__img { align-self: end; width: 100%; max-height: 380px; object-fit: contain; object-position: bottom right; padding-right: 40px; }
  .sales-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 28px; }
  #specials .h2 { margin-bottom: 28px; }
  .mt { position: relative; display: grid; grid-template-columns: 1fr 1fr; align-items: end; overflow: visible; }
  .mt__text { display: grid; gap: 20px; padding: 48px 0 48px 40px; align-self: center; }
  .mt__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .mt__img { width: 100%; max-height: 420px; object-fit: contain; object-position: bottom; margin-top: -40px; }
  @media (max-width: 1023px) {
    .hero-wrap { padding-top: 12px; }
    .hero { grid-template-columns: 1fr; min-height: 0; padding: 28px 20px 0; text-align: center; }
    .hero__text { justify-items: center; padding-bottom: 20px; gap: 18px; }
    .hero__img { padding: 0; max-height: 220px; object-position: bottom center; }
    .mt { grid-template-columns: 1fr; }
    .mt__text { padding: 28px 20px 0; }
    .mt__img { margin-top: 12px; max-height: 300px; }
  }
</style>
