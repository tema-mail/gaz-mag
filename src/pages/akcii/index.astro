---
// /akcii – хаб акций: плитка на каждую акцию (ведёт на её страницу) + «Специальные предложения» магазина.
// На оригинале «Акции» вели на слайдер главной (/#sales).
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ProductRow from '../../components/ProductRow.astro';
import { PROMOS } from '../../lib/promos';
import { listCards } from '../../lib/catalog';
import { img } from '../../lib/img';
import { u } from '../../lib/url';
const specials = listCards('specials');
---
<Base title="Акции магазина газового оборудования в Болотном" description="Скидки пенсионерам 5%, юрлицам и монтажникам 7%, при покупке от 100 тыс. – 7%, монтаж отопления от 8 тыс., стабилизатор в подарок по промокоду GAZMAG. Все акции магазина газового оборудования.">
  <PageHead crumbs={[{ label: 'Главная', href: '/' }, { label: 'Акции' }]} title="Акции" lead="Скидки и предложения магазина газового оборудования. Актуальность и условия уточняйте у менеджера при заказе." />
  <section class="section--tight container">
    <div class="ak">
      {PROMOS.map((p) => (
        <a class="ak__item soft-card reveal" href={u(p.href)}>
          <div class="ak__text">
            <h2 class="ak__t">{p.short}</h2>
            {p.note && <p class="ak__note">({p.note})</p>}
            <span class="btn btn--navy btn--sm">Подробнее</span>
          </div>
          <img src={img(p.image, 800)} alt="" loading="lazy" />
        </a>
      ))}
    </div>
  </section>
  {specials.length > 0 && (
    <section class="section container">
      <h2 class="h2 ak-h">Специальные предложения</h2>
      <ProductRow cards={specials} />
    </section>
  )}
</Base>
<style>
  .ak { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .ak__item { display: grid; grid-template-columns: 1.1fr .9fr; align-items: end; min-height: 280px; border-radius: var(--radius-l); transition: box-shadow .25s, transform .25s var(--ease); }
  .ak__item:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .ak__text { display: grid; gap: 12px; justify-items: start; align-self: center; padding: 28px 0 28px 32px; }
  .ak__t { font-size: clamp(22px, 2.2vw, 30px); }
  .ak__note { font-size: 13px; margin-top: -6px; }
  .ak__item img { width: 100%; height: 260px; object-fit: contain; object-position: bottom right; }
  .ak-h { margin-bottom: 28px; }
  @media (max-width: 1023px) {
    .ak { grid-template-columns: 1fr; gap: 12px; }
    .ak__item { grid-template-columns: 1fr 120px; min-height: 0; }
    .ak__text { padding: 20px 0 20px 18px; }
    .ak__t { font-size: 20px; }
    .ak__item img { height: 150px; }
  }
</style>
