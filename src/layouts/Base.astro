---
import '../styles/global.css';
import '../styles/islands.css';
import '../styles/catalog.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacts from '../components/Contacts.astro';
import Sheets from '../islands/Sheets';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Без общего блока «Контакты» перед подвалом (у посадочной своя развязка). */
  noContacts?: boolean;
  /** Посадочная без шапки и подвала сайта – как /hubert-dy на оригинале. */
  bare?: boolean;
}
const {
  title,
  description = 'Продажа газового оборудования в Болотном: газовые котлы, водонагреватели, бойлеры, радиаторы, датчики загазованности. Подключение газа и монтаж отопления.',
  image, noindex = false, noContacts = false, bare = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Показная копия на GitHub Pages закрыта от поиска, чтобы не дублировать живой gaz-mag.ru.
const closed = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {closed && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#1e294e" />
    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oswald:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="sr-only" href="#main">К содержимому</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && !noContacts && <Contacts />}
    {!bare && <Footer />}
    <Sheets client:idle />
    <div class="cookie" id="cookie" hidden>
      <p>Мы используем файлы cookie и рекомендательные технологии. Пользуясь сайтом, вы соглашаетесь с <a href={u('/policy')}>Политикой обработки персональных данных</a>.</p>
      <button type="button" class="btn btn--navy btn--sm" id="cookie-ok">Принимаю</button>
    </div>
    <script>
      // Плашка cookie – один раз; появление секций при прокрутке.
      const c = document.getElementById('cookie');
      try { if (c && !localStorage.getItem('gm_cookie')) c.hidden = false; } catch {}
      document.getElementById('cookie-ok')?.addEventListener('click', () => {
        if (c) c.hidden = true;
        try { localStorage.setItem('gm_cookie', '1'); } catch {}
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
