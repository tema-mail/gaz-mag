---
import '../styles/global.css';
import '../styles/islands.css';
import '../styles/catalog.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Contacts from '../components/Contacts.astro';
import Sheets from '../islands/Sheets';
import CookieConsent from '../islands/CookieConsent';
import { u } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Без общего блока «Контакты» перед подвалом (у посадочной своя развязка). */
  noContacts?: boolean;
  /** Посадочная без шапки и подвала сайта – как /hubert-dy на оригинале. */
  bare?: boolean;
}
const {
  title,
  description = 'Продажа газового оборудования в Болотном: газовые котлы, водонагреватели, бойлеры, радиаторы, датчики загазованности. Подключение газа и монтаж отопления.',
  image, noindex = false, noContacts = false, bare = false,
} = Astro.props;
// Canonical без слеша в конце – адреса страниц как на Тильде (/montag, а не /montag/).
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
// Показная копия на GitHub Pages закрыта от поиска, чтобы не дублировать живой gaz-mag.ru.
const closed = noindex || import.meta.env.PUBLIC_NOINDEX === '1';
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {closed && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="theme-color" content="#1e294e" />
    {/* подтверждение прав в Яндекс Вебмастере (логин artemiy.galimov, 21.10.2026); Google – файл public/google8a8cbc5492746f08.html */}
    <meta name="yandex-verification" content="a27933a9626f95c6" />
    <link rel="icon" href={u('/favicon.png')} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Oswald:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="sr-only" href="#main">К содержимому</a>
    {!bare && <Header />}
    <main id="main">
      <slot />
    </main>
    {!bare && !noContacts && <Contacts />}
    {!bare && <Footer />}
    <Sheets client:idle />
    <CookieConsent client:load />
    <script>
      // Появление секций при прокрутке; кнопки «Настройки cookie» открывают окно согласия.
      document.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('[data-cookie-settings]')) window.dispatchEvent(new Event('gm-consent-open'));
      });
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -8% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
